<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>{% block title %}{% endblock %}</title>
<style>
:root {
  --bg: #ffffff; --fg: #1d2129; --muted: #5f6b7a; --border: #dde2e8;
  --card: #f6f8fa; --accent: #0b6bcb; --code: #f0f2f5;
  --ok: #1a7f37; --warn: #9a6700; --bad: #cf222e; --info: #0b6bcb;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0f1216; --fg: #e3e6ea; --muted: #98a2ae; --border: #2b313a;
    --card: #171b21; --accent: #5aa9f5; --code: #1d2229;
    --ok: #4ac26b; --warn: #d4a72c; --bad: #ff7b72; --info: #5aa9f5;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
a { color: var(--accent); }
h1 { font-size: 1.6rem; margin: 0 0 4px; }
h2 { font-size: 1.2rem; margin: 32px 0 12px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
h3 { font-size: 1rem; margin: 0; }
.muted { color: var(--muted); }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; margin: 16px 0; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; overflow-wrap: anywhere; }
table { width: 100%; border-collapse: collapse; }
th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
th { color: var(--muted); font-weight: 600; font-size: .85rem; }
.table-wrap { overflow-x: auto; }
.badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: .78rem;
  font-weight: 600; border: 1px solid currentColor; white-space: nowrap; }
.s-completed, .s-accepted { color: var(--ok); }
.s-failed, .s-timed-out, .s-canceled, .s-rejected, .p-critical, .p-high { color: var(--bad); }
.s-in-progress, .s-running, .s-waiting, .s-pending-customer-approval, .p-medium { color: var(--warn); }
.card { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; margin: 10px 0; }
.card header { display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline; margin-bottom: 6px; }
.body { white-space: pre-wrap; overflow-wrap: anywhere; }
pre { background: var(--code); padding: 10px; border-radius: 6px; overflow-x: auto; font-size: .82rem; margin: 6px 0 0; }
details summary { cursor: pointer; color: var(--muted); font-size: .85rem; }
.exec { border-left: 3px solid var(--border); padding-left: 12px; margin: 18px 0; }
.exec.child { margin-left: 20px; }
.md > :first-child { margin-top: 0; } .md > :last-child { margin-bottom: 0; }
.md h3, .md h4, .md h5, .md h6 { margin: 16px 0 6px; } .md p { margin: 6px 0; }
.md ul, .md ol { margin: 6px 0; padding-left: 22px; }
.md code, .ev code { background: var(--code); padding: 1px 4px; border-radius: 4px; font-size: .88em; }
.md pre code { background: none; padding: 0; }
.md blockquote { margin: 6px 0; padding-left: 12px; border-left: 3px solid var(--border); color: var(--muted); }
.md table { margin: 8px 0; font-size: .9rem; }
.md hr { border: 0; border-top: 1px solid var(--border); margin: 14px 0; }
.ui details { margin: 6px 0; } .ui .card { background: var(--bg); }
.kv { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; margin: 4px 0; font-size: .9rem; }
.kv dt { color: var(--muted); } .kv dd { margin: 0; overflow-wrap: anywhere; }
.kv-list { margin: 4px 0; padding-left: 20px; }
.ev { margin: 8px 0; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border); }
.ev .who, .ev .sub { font-size: .78rem; color: var(--muted); font-weight: 600; margin-bottom: 4px; }
.ev .sub { margin-top: 8px; }
.ev.prompt { background: var(--card); border-left: 3px solid var(--warn); }
.ev.assistant { border-left: 3px solid var(--accent); }
.ev.thinking, .ev.tool { padding: 4px 12px; background: var(--card); }
.ev.thinking summary, .ev.tool summary { font-size: .88rem; }
.ev.thinking .md { color: var(--muted); font-size: .9rem; margin-top: 6px; }
footer { margin-top: 48px; color: var(--muted); font-size: .8rem; }
@media print { details { display: block; } details > summary { display: none; } }
</style>
</head>
<body>
<main>
{% block content %}{% endblock %}
<footer>Generated {{ generated | ts }} from Agent Space {{ space.name }} ({{ space.agentSpaceId }}).</footer>
</main>
</body>
</html>
